// Zed keymap — https://zed.dev/docs/key-bindings
// `secondary-` resolves to `cmd` on macOS and `ctrl` on Linux/Windows,
// keeping these bindings consistent across platforms.
[
  {
    "bindings": {
      "secondary-shift-b": "agent::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "secondary-shift-b": "outline_panel::ToggleFocus",
    },
  },
  {
    "unbind": {
      "secondary-q": "zed::Quit",
    },
  },
  {
    "context": "SkillCreator > Editor",
    "unbind": {
      "secondary-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "SkillCreator",
    "unbind": {
      "secondary-w": "workspace::CloseWindow",
    },
  },
  {
    "unbind": {
      "secondary-shift-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "secondary-.": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "AcpThread",
    "bindings": {
      "secondary-.": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "secondary-.": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "secondary-\\": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "secondary-`": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "secondary-\\": "pane::SplitRight",
    },
  },
  {
    "context": "Editor && !showing_completions",
    "bindings": {
      "alt-space": "editor::ShowCompletions",
    },
  },
  {
    "bindings": {
      "secondary-|": "workspace::NewTerminal",
      "secondary-shift-x": "zed::Extensions",
      "secondary-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "secondary->": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "AcpThread",
    "unbind": {
      "secondary->": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "secondary->": "agent::AddSelectionToThread",
    },
  },
]
