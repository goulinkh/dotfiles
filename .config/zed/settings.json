// Zed settings — https://zed.dev/docs/configuring-zed
// Only non-default values are kept here; run `zed: open default settings`
// from the command palette to see everything else.
{
  // === appearance ===
  "ssh_connections": [
    {
      "host": "thinkpad",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/goulin.khoge@canonical.com/Lab/canonical/sd-tools/./",
          ],
        },
      ],
    },
  ],
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Material Icon Theme",
  },
  "ui_font_family": ".ZedSans",
  "ui_font_size": 15,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 15,
  "agent_ui_font_size": 15,

  "buffer_font_features": {
    "calt": true, // standard ligatures (-> => != etc)
    "cv02": true, // alternative `a` with top arm
    "cv05": true, // alternative `g` in double story style
    "cv61": true, // alternative `,` and `;` with straight tail
    "cv63": true, // alternative `<=` in arrow style
  },
  "colorize_brackets": true,
  "document_symbols": "on",
  "diff_view_style": "split",
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
        "font_weight": 300,
      },
      "keyword": {
        "font_style": "italic",
      },
      "keyword.import": {
        "font_style": "italic",
      },
      "keyword.type": {
        "font_style": "italic",
      },
      "type": {
        "font_style": "italic",
      },
    },
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },

  // === editor behavior ===
  "scroll_beyond_last_line": "off",
  "double_click_in_multibuffer": "open",
  "close_on_file_delete": true,
  "use_smartcase_search": true,
  "inlay_hints": {
    "enabled": false,
  },
  "git": {
    "inline_blame": {
      "delay_ms": 200,
      "show_commit_summary": true,
    },
  },
  "preview_tabs": {
    "enabled": true,
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_from_file_finder": true,
  },
  "seed_search_query_from_cursor": "selection",

  // === title bar ===
  "title_bar": {
    "show_branch_status_icon": true,
    "show_user_picture": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_user_menu": true,
    "show_menus": true,
    "show_sign_in": false,
  },

  // === tab bar ===
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "show_diagnostics": "errors",
    "git_status": true,
    "file_icons": true,
    "activate_on_close": "neighbour",
  },

  // === Panels ===
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": true,
    "show_count_badge": true,
    "file_icons": true,
    "status_style": "icon",
  },
  "project_panel": {
    "dock": "left",
    "button": false,
    "default_width": 300,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "entry_spacing": "standard",
    "diagnostic_badges": true,
    "git_status_indicator": true,
  },
  "agent_servers": {
    "omp": {
      "default_config_options": {
        "mode": "default",
        "model": "github-copilot/claude-opus-4.8",
      },
      "type": "custom",
      "command": "omp",
      "args": ["acp"],
    },
    "github-copilot-cli": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#autopilot",
        "model": "claude-sonnet-4.6",
      },
      "type": "registry",
    },
  },
  // === File finder ===
  "file_finder": {
    "modal_max_width": "medium",
    "include_ignored": "all",
  },
  // === Diagnostics ===
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 150,
      "prompt_format": "glm",
      "model": "z-ai/glm-5.2",
      "api_url": "https://openrouter.ai/api/v1",
    },
    "provider": "open_ai_compatible_api",
    "allow_data_collection": "no",
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false,
    "tool_permissions": {
      "default": "allow",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.8",
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-opus-4.8",
    },
    "subagent_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "commit_message_instructions": "follow conventional commits",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "soft_wrap": "editor_width",
  // === Terminal ===
  "terminal": {
    "button": true,
    "scrollbar": {
      "show": "auto",
    },
    "max_scroll_history_lines": 5000000,
    "font_family": "Maple Mono NF",
    "font_features": {
      "calt": true,
      "cv02": true,
      "cv05": true,
      "cv61": true,
      "cv63": true,
    },
    "detect_venv": {
      "on": {
        "activate_script": "default",
      },
    },
    "env": {
      "GIT_EDITOR": "zed --wait",
      "EDITOR": "zed",
    },
    "minimum_contrast": 60,
    "keep_selection_on_copy": false,
  },
  "load_direnv": "shell_hook",

  // === Extensions ===
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "github-actions": true,
    "go-snippets": true,
    "html": true,
    "make": true,
    "markdown-oxide": true,
    "material-icon-theme": true,
    "nginx": true,
    "prisma": true,
    "scheme": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "vscode-icons": true,
    "zedokai": true,
  },
}
