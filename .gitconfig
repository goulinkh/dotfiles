[user]
	name = Goulin Khoge
	email = contact+git@goulin.fr

[init]
	defaultBranch = main

[core]
	editor = vim
	autocrlf = input

[color]
	ui = auto

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = zebra

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	unstage = reset HEAD --
	lg = log --oneline --graph --decorate --all
	amend = commit --amend --no-edit
