[user]
	name = Goulin Khoge
	email = contact+git@goulin.fr

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.gitallowedsigners

# Signing key + commit/tag gpgsign live here, written by setup-git-signing.sh
# only when the SSH signing key exists. No key => commits succeed unsigned.
[include]
	path = ~/.config/git/signing.local

[init]
	defaultBranch = main

[core]
	editor = vim
	autocrlf = input

[color]
	ui = auto

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = zebra

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	unstage = reset HEAD --
	lg = log --oneline --graph --decorate --all
	amend = commit --amend --no-edit
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
