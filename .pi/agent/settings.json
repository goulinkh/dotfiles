{
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-5.5",
  "enabledModels": [
    "github-copilot/claude-opus-5.5",
    "github-copilot/gemini-4-argon",
    "openai-codex/gpt-6-astra"
  ],
  "defaultThinkingLevel": "xhigh",
  "defaultTools": [
    "+codemode",
    "+grep",
    "+find",
    "+ls"
  ],
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "quietStartup": true,
  "tuiMode": "regular",
  "packages": [
    "npm:pi-notify@1.4.0",
    "git:github.com/goulinkh/pi-usage",
    "npm:better-claude-code-ui",
    "~/.config/pi/compact-status-line",
    "npm:@pi-plugins/fast-mode@0.1.13",
    "npm:pi-btw",
    "npm:pi-auto-title@0.4.0"
  ],
  "lastChangelogVersion": "1.4.0",
  "pi-usage": {
    "usageMode": "used",
    "usagePlacement": "inlineFooter"
  }
}
