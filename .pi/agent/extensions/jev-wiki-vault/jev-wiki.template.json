{
  "provider": "openrouter",
  "model": "~typesafe/jev-latest",
  "apiKey": "$JEV_WIKI_API_KEY",
  "envFile": "${PI_AGENT_DIR}/jev-wiki.env",
  "wikiRoot": "${PI_WIKI_VAULT}/global",
  "globalWikiRoot": "${PI_WIKI_VAULT}/global",
  "capture": { "cadence": "manual", "onCompact": false, "onSettle": false, "route": "subject", "triggerTurn": false },
  "writer": { "mode": "guided" },
  "review": { "autoAcceptUserStated": false },
  "thresholds": {
    "autoAccept": 0.95,
    "minSupport": 0.95,
    "minDerivable": 0.3,
    "framingImportance": 1,
    "minImportance": 2
  },
  "hooks": { "autoRetrieve": { "mode": "off" } },
  "search": {
    "vector": {
      "model": "performance",
      "scan": { "roots": ["${PI_WIKI_VAULT}"], "wsl": false }
    }
  }
}
