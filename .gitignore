.DS_Store
*.bak
# Keep .zsh.local a template only — never put real secrets in the repo copy.

# omp writes runtime lock files beside its config.
.omp/agent/*.lock

# OMP writes its SQLite runtime database beside the agent config.
.omp/agent/agent.db*

# Pi credentials and runtime files stay local; only explicitly listed config is portable.
.pi/agent/*
!.pi/agent/settings.json
!.pi/agent/models.json
!.pi/agent/APPEND_SYSTEM.md
!.pi/agent/pi-auto-title.json
!.pi/agent/extensions/
.pi/agent/extensions/*
!.pi/agent/extensions/fast-mode.json
!.pi/agent/extensions/openrouter-vertex.ts
!.pi/agent/extensions/jev-wiki-vault/

# Herdr writes editor type files into each mod folder.
.config/herdr-app/mods/*/gpui-kit.d.ts
.config/herdr-app/mods/*/jsconfig.json

# Python writes bytecode caches when the tests run.
__pycache__/
